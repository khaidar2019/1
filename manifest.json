{
  "manifest_version": 3,
  "name": "Bulk Messenger (WhatsApp + Telegram)",
  "description": "Send bulk messages from an Excel file via WhatsApp Web and Telegram Web.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://t.me/*"
  ]
}
